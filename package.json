{
    "name": "@tdev/core",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "docusaurus": "docusaurus",
        "start": "tsx updateSync/packageDocsSync/preBuild.ts --src packages --dest tdev-website/docs/packages && concurrently --raw --kill-others 'docusaurus start' 'tsx updateSync/packageDocsSync/watch.ts --src packages --dest tdev-website/docs/packages --skip-initial'",
        "prebuild": "pnpm --filter @tdev/material-sync run sync && tsx updateSync/packageDocsSync/preBuild.ts --src packages --dest tdev-website/docs/packages",
        "build": "docusaurus build",
        "swizzle": "docusaurus swizzle",
        "deploy": "docusaurus deploy",
        "clear": "docusaurus clear",
        "serve": "docusaurus serve",
        "write-translations": "docusaurus write-translations",
        "write-heading-ids": "docusaurus write-heading-ids",
        "typecheck": "tsc",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest --coverage --configLoader runner",
        "updateTdev": "tsx updateSync/updateTdev.ts",
        "sync": "pnpm --filter @tdev/material-sync run sync",
        "remove": "pnpm --filter @tdev/material-sync run remove",
        "postremove": "pnpm --filter @tdev/material-sync run sync",
        "precleanup": "pnpm --filter @tdev/material-sync run restore",
        "cleanup": "pnpm --filter @tdev/material-sync run cleanup",
        "add": "pnpm --filter @tdev/material-sync run add",
        "addClass": "pnpm --filter @tdev/material-sync run addClass",
        "postadd": "pnpm --filter @tdev/material-sync run sync"
    },
